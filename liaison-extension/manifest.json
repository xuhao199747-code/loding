{
  "manifest_version": 3,
  "name": "Liaison - AI Design & Annotation",
  "version": "1.0.0",
  "description": "AI programming locator, web style editor and annotation tool based on VisBug",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Toggle Liaison"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "liaison-app/**/*",
        "**/*.css",
        "**/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
